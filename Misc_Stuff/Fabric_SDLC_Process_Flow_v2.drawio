        <mxCell id="s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" value="1&#xa;PLAN&#xa;Scope and architect solution&#xa;CLI&#xa;Model schema, pipeline design, DAX strategy. Output: ADR / spec committed as markdown to repo" vertex="1">
          <mxGeometry height="140" width="300" x="430" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" value="2&#xa;SETUP&#xa;Create Azure DevOps repo; clone locally; initialise Git&#xa;SYS&#xa;One-time. Establish dev / test / prod branch strategy" vertex="1">
          <mxGeometry height="120" width="300" x="430" y="290" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" value="3&#xa;SETUP&#xa;Link Fabric workspace to DevOps repo (Git Integration)&#xa;SYS&#xa;One-time per workspace" vertex="1">
          <mxGeometry height="110" width="300" x="430" y="450" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" value="4&#xa;SETUP&#xa;Configure MCP servers in CC CLI&#xa;SYS&#xa;ms-fabric-mcp-server + powerbi-modeling-mcp; opt-in per session to control token cost" vertex="1">
          <mxGeometry height="140" width="300" x="430" y="600" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" value="5&#xa;SCAFFOLD&#xa;Scaffold empty Fabric artifact shells via MCP&#xa;CLI&#xa;create_lakehouse, create_pipeline, create_notebook, create_dataflow, create_semantic_model, create_folder. Containers only — no content yet" vertex="1">
          <mxGeometry height="160" width="300" x="430" y="780" as="geometry" />
