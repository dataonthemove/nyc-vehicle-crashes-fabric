        <mxCell id="s15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0b8180;align=center;" value="15. PR review and merge in ADO [SYS]&#xa;Peer review of TMDL, T-SQL, pipeline JSON,&#xa;report definitions. Merge on approval" vertex="1">
          <mxGeometry height="80" width="260" x="430" y="2260" as="geometry" />
