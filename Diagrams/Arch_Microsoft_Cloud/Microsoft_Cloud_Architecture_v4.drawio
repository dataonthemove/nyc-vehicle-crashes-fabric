        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#ffffff;strokeColor=#999999;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;KEY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Overlap &lt;/b&gt;= shared component or platform relationship&lt;br&gt;&lt;div&gt;&lt;b&gt;Solid arrow &lt;/b&gt;= integration / data flow&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Horizontal band &lt;/b&gt;= cross-cutting capability (availability varies by service)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Microsoft SaaS services&amp;nbsp;&lt;/b&gt;generally run on Microsoft-managed cloud infrastructure&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="320" x="39" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="billing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#ffffff;strokeColor=#999999;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;&lt;font&gt;BILLING &amp;amp; CAPACITY&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;&lt;br&gt;Azure — &lt;/b&gt;resource consumption through subscriptions&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;M365 / D365 / Power Platform / Power BI — &lt;/b&gt;user licences and/or capacity, depending on service&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;Fabric — &lt;/b&gt;F-SKU capacity provisioned through Azure; Power BI Pro / PPU are per-user licenses&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;Copilot — &lt;/b&gt;licensing or capacity requirements vary by product&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="590" x="370" y="1090" as="geometry" />
