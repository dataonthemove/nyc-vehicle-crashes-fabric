<mxfile host="Claude"><diagram id="cmp" name="Local vs Projects"><mxGraphModel dx="1700" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style='font-size:24px'&gt;Claude Code: local code-first workflow vs. Claude Projects&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;Hierarchies, caveats and comparison. Checked against code.claude.com/docs/en/claude-projects on 2026-11-25. Projects are in public beta, so details may change.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:17px'&gt;A. Local code-first (your Fabric workflow)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="780" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Repo folder&lt;/b&gt;&lt;sup&gt;&lt;b&gt;1&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;e.g. NYC_VehicleCrashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="145" width="300" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;You&lt;/b&gt; =&lt;br&gt;coordinator&lt;sup&gt;&lt;b&gt;2&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;starts / steers&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="30" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Session A&lt;/b&gt;&lt;sup&gt;&lt;b&gt;3&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;Full Claude Code session&lt;br&gt;Repo folder &lt;i&gt;or&lt;/i&gt; its own worktree&lt;sup&gt;&lt;b&gt;4&lt;/b&gt;&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="290" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Session B&lt;/b&gt;&lt;sup&gt;&lt;b&gt;3&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;Full Claude Code session&lt;br&gt;Repo folder &lt;i&gt;or&lt;/i&gt; its own worktree&lt;sup&gt;&lt;b&gt;4&lt;/b&gt;&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="250" width="290" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Subagents&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;report to Session A only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="375" width="220" height="50" as="geometry"/></mxCell><mxCell id="c21" value="Subagents&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;report to Session B only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="375" width="220" height="50" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c16" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Tools on your PC&lt;/b&gt;&lt;sup&gt;&lt;b&gt;6&lt;/b&gt;&lt;/sup&gt;: Fabric MCP · Git · PBID files · VSC" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="440" width="640" height="32" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Delivery path&lt;/b&gt; (you control every step)" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="400" height="24" as="geometry"/></mxCell><mxCell id="c26" value="Local branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="130" height="54" as="geometry"/></mxCell><mxCell id="c27" value="Commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="202" y="512" width="130" height="54" as="geometry"/></mxCell><mxCell id="c28" value="Push to ADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="354" y="512" width="130" height="54" as="geometry"/></mxCell><mxCell id="c29" value="Pull request (ADO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="506" y="512" width="130" height="54" as="geometry"/></mxCell><mxCell id="c30" value="Fabric workspace sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="658" y="512" width="130" height="54" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Footnotes: A. Local code-first&lt;/b&gt;&lt;br&gt;&lt;sup&gt;&lt;b&gt;1&lt;/b&gt;&lt;/sup&gt; The repo folder carries the CLAUDE.md file, rules, skills, the &lt;code&gt;.mcp.json&lt;/code&gt; file and folder-scoped memory. Any git host works, including ADO.&lt;br&gt;&lt;sup&gt;&lt;b&gt;2&lt;/b&gt;&lt;/sup&gt; You coordinate. In the desktop app, a session can also propose or start sibling sessions, with your approval.&lt;br&gt;&lt;sup&gt;&lt;b&gt;3&lt;/b&gt;&lt;/sup&gt; Sessions in one repo share its files, its CLAUDE.md file and its folder memory, but not each other's conversations. You choose the permission mode per session.&lt;br&gt;&lt;sup&gt;&lt;b&gt;4&lt;/b&gt;&lt;/sup&gt; A worktree is optional. It isolates parallel sessions working in the same repo.&lt;br&gt;&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt; Subagents are short-lived helpers that report only to the session that started them.&lt;br&gt;&lt;sup&gt;&lt;b&gt;6&lt;/b&gt;&lt;/sup&gt; All tools run locally, so everything stops when the laptop sleeps or closes.&lt;br&gt;&lt;b&gt;Verdict:&lt;/b&gt; this stays the right fit for Fabric, because the Fabric MCP, PBID and ADO all live on or reach from your PC." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;spacing=10;fillColor=#f8fbff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="780" height="230" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:17px'&gt;B. Claude Projects (new, public beta)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#7f4a00;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="780" height="30" as="geometry"/></mxCell><mxCell id="c37" value='&lt;b&gt;Project&lt;/b&gt;&lt;sup&gt;&lt;b&gt;1&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;e.g. "Fabric" or "DP-600"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="145" width="300" height="56" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Coordinator conversation&lt;/b&gt;&lt;sup&gt;&lt;b&gt;2&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;the ongoing chat: plans the work, starts threads, gets their reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="225" width="400" height="56" as="geometry"/></mxCell><mxCell id="c39" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Thread A, cloud&lt;/b&gt; (default)&lt;sup&gt;&lt;b&gt;3&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;Full Claude Code session&lt;br&gt;Fresh branch in a cloud sandbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="305" width="290" height="70" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Thread B, local&lt;/b&gt; (optional)&lt;sup&gt;&lt;b&gt;4&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;Full Claude Code session&lt;br&gt;Connected folder, Worktree toggle optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="305" width="290" height="70" as="geometry"/></mxCell><mxCell id="c42" value="1 : many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c38" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="Subagents&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;report to Thread A only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="395" width="220" height="45" as="geometry"/></mxCell><mxCell id="c45" value="Subagents&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;report to Thread B only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="395" width="220" height="45" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c40" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c41" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="Coordinator's own subagents?&lt;br&gt;&lt;span style='font-size:11px'&gt;unconfirmed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="170" height="45" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c38" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Delivery path, cloud thread&lt;/b&gt; (coordinator and threads drive it; you approve and merge)" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="455" width="780" height="24" as="geometry"/></mxCell><mxCell id="c51" value="New branch from the default branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="485" width="130" height="54" as="geometry"/></mxCell><mxCell id="c52" value="Commit and push to GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1042" y="485" width="130" height="54" as="geometry"/></mxCell><mxCell id="c53" value="Pull request (github.com)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1194" y="485" width="130" height="54" as="geometry"/></mxCell><mxCell id="c54" value="Auto-fix watches CI and review comments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1346" y="485" width="130" height="54" as="geometry"/></mxCell><mxCell id="c55" value="You merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1498" y="485" width="130" height="54" as="geometry"/></mxCell><mxCell id="c56" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Footnotes: B. Claude Projects&lt;/b&gt;&lt;br&gt;&lt;sup&gt;&lt;b&gt;1&lt;/b&gt;&lt;/sup&gt; There is one coordinator per project, and each project belongs to one user. Public beta on Pro, Max and Ultra plans, in claude.ai/code, the desktop app and mobile apps, not the CLI, VSC or JetBrains. Usage is heavier than a single session.&lt;br&gt;&lt;sup&gt;&lt;b&gt;2&lt;/b&gt;&lt;/sup&gt; The coordinator sees what threads report back, not every step they take. Approvals happen inside each thread; a chat message to the coordinator doesn't answer a waiting thread.&lt;br&gt;&lt;sup&gt;&lt;b&gt;3&lt;/b&gt;&lt;/sup&gt; Cloud threads work on &lt;b&gt;github.com repos only&lt;/b&gt;, with the Claude GitHub App installed; ADO, GitLab and Bitbucket aren't supported. They inherit the project instructions, project memory, and each repo's CLAUDE.md files, rules and skills. They do &lt;b&gt;not&lt;/b&gt; load &lt;code&gt;.mcp.json&lt;/code&gt;, hooks, permission rules or env settings, so they get &lt;b&gt;no Fabric MCP&lt;/b&gt;. They keep running with the laptop closed. Uncommitted sandbox work can be lost.&lt;br&gt;&lt;sup&gt;&lt;b&gt;4&lt;/b&gt;&lt;/sup&gt; Local threads need the folder connected through Remote Control (Settings › Code). They run in &lt;b&gt;auto mode&lt;/b&gt; and use the folder itself by default. They get the project instructions but not the project memory. Two threads in one folder can overwrite each other's changes. They pause while the PC sleeps.&lt;br&gt;&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt; Threads can use subagents for their own side tasks.&lt;br&gt;&lt;b&gt;Note:&lt;/b&gt; local Code-tab sessions stay outside Projects. Projects add a new option; they don't replace local sessions." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;spacing=10;fillColor=#fffaf3;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="780" height="260" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style='font-size:17px'&gt;C. Side-by-side comparison&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1620" height="30" as="geometry"/></mxCell><mxCell id="c62" value="&lt;table style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr&gt;&lt;th style='border:1px solid #999;padding:6px;background:#e6e6e6;text-align:left'&gt;Level&lt;/th&gt;&lt;th style='border:1px solid #999;padding:6px;background:#dae8fc;text-align:left'&gt;A. Local code-first (your Fabric workflow)&lt;/th&gt;&lt;th style='border:1px solid #999;padding:6px;background:#ffe6cc;text-align:left'&gt;B. Projects (new, beta)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Top container&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Repo folder, e.g. NYC_VehicleCrashes&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Project, e.g. &amp;quot;Fabric&amp;quot; or &amp;quot;DP-600&amp;quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;&lt;b&gt;Shared context&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Repo files, CLAUDE.md file, rules, skills, folder memory, .mcp.json file&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Project instructions, project memory, the repo&amp;#x27;s CLAUDE.md files, rules and skills (no .mcp.json, hooks or permission rules)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Coordinator&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;You (a session can propose or start sibling sessions, with your approval)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Coordinator conversation (sees thread reports, not every step)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;&lt;b&gt;Worker unit&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Session: a full Claude Code session you start and steer&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Thread: a full Claude Code session the coordinator starts; you can open and steer it&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Where workers run&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Your PC: the repo folder or its own worktree&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Cloud sandbox (default), or a local connected folder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;&lt;b&gt;Isolation&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Optional git worktree&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Cloud: a fresh branch per thread. Local: the folder by default, Worktree toggle optional&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Permission mode&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Your choice per session&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Local threads run in auto mode; cloud threads ask you inside each thread&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;&lt;b&gt;Helpers&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Subagents, reporting to their session&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Subagents, reporting to their thread (coordinator: unconfirmed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Tools available&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Fabric MCP, Git, PBID files, VSC&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Cloud: GitHub and claude.ai connectors only. Local: your machine&amp;#x27;s tools&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;&lt;b&gt;Repo host&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;ADO (any host works)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;github.com only (no ADO)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Delivery path&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Branch → commit → push to ADO → pull request → Fabric workspace sync&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;Branch → pull request on GitHub (auto-fix watches CI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;&lt;b&gt;Runs with laptop closed&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;No&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#f7f7f7'&gt;Cloud threads, yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Where available&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;CLI, desktop app, VSC, JetBrains&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:6px;vertical-align:top;background:#ffffff'&gt;claude.ai/code, desktop app, mobile&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1620" height="385" as="geometry"/></mxCell><mxCell id="c63" value="&lt;i&gt;The two are separate. Local sessions stay outside Projects, though you can bring their work into one later.&lt;/i&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="1620" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>