        <mxCell id="c33" edge="1" parent="1" source="c28" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="c29" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c34" edge="1" parent="1" source="c29" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="c30" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;spacing=10;fillColor=#f8fbff;strokeColor=#6c8ebf;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;Footnotes: A. Local code-first&lt;/b&gt;&lt;br&gt;&lt;sup&gt;&lt;b&gt;1&lt;/b&gt;&lt;/sup&gt; The repo folder carries the CLAUDE.md file, rules, skills, the &lt;code&gt;.mcp.json&lt;/code&gt; file and folder-scoped memory. Any git host works, including ADO.&lt;br&gt;&lt;sup&gt;&lt;b&gt;2&lt;/b&gt;&lt;/sup&gt; You coordinate. In the desktop app, a session can also propose or start sibling sessions, with your approval.&lt;br&gt;&lt;sup&gt;&lt;b&gt;3&lt;/b&gt;&lt;/sup&gt; Sessions in one repo share its files, its CLAUDE.md file and its folder memory. You choose the permission mode per session.&lt;br&gt;&lt;sup&gt;&lt;b&gt;4&lt;/b&gt;&lt;/sup&gt; A worktree is optional. It isolates parallel sessions working in the same repo.&lt;br&gt;&lt;sup&gt;&lt;b&gt;5&lt;/b&gt;&lt;/sup&gt; Subagents are short-lived helpers that report only to the session that started them.&lt;br&gt;&lt;sup&gt;&lt;b&gt;6&lt;/b&gt;&lt;/sup&gt; All tools run locally, so everything stops when the laptop sleeps or closes.&lt;br&gt;&lt;b&gt;Verdict:&lt;/b&gt; this stays the right fit for Fabric, because the Fabric MCP, PBID and ADO all live on or reach from your PC. A local project thread also uses your PC&#39;s tools, including the Fabric MCP; only cloud threads lack it." vertex="1">
          <mxGeometry height="230" width="780" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="c36" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#7f4a00;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b style=&#39;font-size:17px&#39;&gt;B. Claude Projects (new, public beta)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="780" x="880" y="100" as="geometry" />
        </mxCell>
