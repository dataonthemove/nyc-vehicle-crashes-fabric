        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#999999;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Physical storage&lt;br&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Compute engine (holds no data)&lt;br&gt;&lt;span style=&quot;background:#fff2cc;border:1px solid #d6b656;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Refresh / framing&lt;br&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Persisted data copy&lt;br&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Data in memory (VertiPaq)&lt;br&gt;&lt;span style=&quot;background:#ffffff;border:1px dashed #666666;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Metadata only&lt;br&gt;&lt;span style=&quot;background:#f8cecc;border:1px dashed #b85450;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Fallback only&lt;br&gt;Model border: solid orange = owns a persisted copy · dashed grey = metadata only&lt;br&gt;&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px solid #d79b00;vertical-align:middle;&quot;&gt;&lt;/span&gt; Data moved at refresh&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px solid #6c8ebf;vertical-align:middle;&quot;&gt;&lt;/span&gt; Query-time data&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px dashed #666666;vertical-align:middle;&quot;&gt;&lt;/span&gt; Request / metadata&lt;br&gt;&lt;span style=&quot;display:inline-block;width:26px;border-top:2px dashed #b85450;vertical-align:middle;&quot;&gt;&lt;/span&gt; Fallback path&lt;br&gt;" vertex="1">
