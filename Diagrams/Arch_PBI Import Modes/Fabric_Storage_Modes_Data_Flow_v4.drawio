        <mxCell id="cmp" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:13%;&quot;&gt;Aspect&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:29%;&quot;&gt;Import&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:29%;&quot;&gt;DirectQuery&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:29%;&quot;&gt;Direct Lake&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Data held in model&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Full compressed copy&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;None&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;None — Delta version pointer only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Refresh moves data?&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Yes — slow, volume-bound&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;No data refresh&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;No — framing in seconds&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Freshness&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;As of last refresh&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Live&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;As of last framing (auto-updates ≈ near real time)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Query speed&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Fastest — all in memory&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Slowest — SQL per visual&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Import-like once warm; first query pays transcoding&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Transformations&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Power Query, calculated columns&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Limited; pushed to source&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Shape upstream in Delta; calculated columns on OneLake variant only (preview)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;When too large&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Capacity model-memory limit&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Source-bound&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Table guardrails: fallback (SQL endpoints) or error (OneLake). Memory pressure: column eviction&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Security / identity&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Model RLS/OLS; source read with refresh credentials; viewers never touch source&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Model RLS; SSO can pass viewer identity to source security&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Model RLS/OLS; SSO or fixed identity; source permissions checked per variant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Mixing modes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Combine with DirectQuery tables; Dual for shared dimensions&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Combine with Import; Dual dimensions avoid limited relationships&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;OneLake variant: add Import tables. SQL endpoints: composite only on top, in Desktop&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="360" width="1300" x="280" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="var" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:24%;&quot;&gt;Direct Lake variant&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:38%;&quot;&gt;on OneLake&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;width:38%;&quot;&gt;on SQL endpoints&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Binds to&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Delta tables in one or more Fabric items&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;One item&#39;s SQL analytics endpoint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;DirectQuery fallback&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;None — guardrail breach fails framing; queries error&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Yes — table guardrails, SQL views, SQL RLS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;SQL endpoint RLS&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Not applied — OneLake access enforced instead&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Applied via fallback&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;SQL endpoint OLS/CLS&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Not supported&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Supported; denied access returns an error&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Identity&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;SSO or fixed identity&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;SSO or fixed identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Permission check&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;OneLake security roles, or item Read + ReadAll&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Item Read + SELECT via SQL endpoint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Import tables in same model&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Supported (web modeling)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Not supported&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Calculated columns&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;User Context only (preview)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Not supported&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
