        <mxCell id="cmp" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;&quot;&gt;Aspect&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;&quot;&gt;Import&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;&quot;&gt;DirectQuery&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;background:#333;color:#fff;text-align:left;&quot;&gt;Direct Lake&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Data held in model&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Full compressed copy&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;None&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;None — Delta version pointer only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Refresh moves data?&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Yes — slow, volume-bound&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;No data refresh&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;No — framing in seconds&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Freshness&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;As of last refresh&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Live&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;As of last framing (auto-updates ≈ near real time)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Query speed&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Fastest — all in memory&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Slowest — SQL per visual&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Import-like once warm; first query pays transcoding&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;Transformations&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Power Query, calculated columns&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Limited; pushed to source&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Shape upstream in Delta; calculated columns in preview&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;&lt;b&gt;When too large&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Capacity model-memory limit&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;Source-bound&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;text-align:left;vertical-align:top;&quot;&gt;SKU guardrails → fallback to DirectQuery, or error&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
