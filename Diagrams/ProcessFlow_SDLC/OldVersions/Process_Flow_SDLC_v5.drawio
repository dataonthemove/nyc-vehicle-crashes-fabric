<mxfile host="app.diagrams.net" modified="2026-07-18T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="fabric-sdlc-flow-v5" name="Fabric SDLC Process Flow v5">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0" background="#F2F2F2">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Microsoft Fabric SDLC Process Flow (v5) — Source-to-Semantic-Model Workflow" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="720" height="40" as="geometry" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="legendBox" value="Legend — Operational Domain" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="70" width="300" height="226" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="CC Modifying Local Files (+ VSC Extension)" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="legendBox">
          <mxGeometry x="15" y="38" width="270" height="28" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="CC using MCP to modify Fabric" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="legendBox">
          <mxGeometry x="15" y="74" width="270" height="28" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="Fabric / Azure DevOps / Git" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="legendBox">
          <mxGeometry x="15" y="110" width="270" height="28" as="geometry" />
        </mxCell>
        <mxCell id="leg5" value="Azure DevOps (ADO) — sole activity surface" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="legendBox">
          <mxGeometry x="15" y="146" width="270" height="28" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="Decision Gateway" style="rhombus;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="legendBox">
          <mxGeometry x="15" y="182" width="270" height="28" as="geometry" />
        </mxCell>

        <!-- ===== ABBREVIATIONS KEY ===== -->
        <mxCell id="abbrevBox" value="Key — Abbreviations" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="316" width="300" height="265" as="geometry" />
        </mxCell>
        <mxCell id="abbrevText" value="&lt;b&gt;ADO&lt;/b&gt; — Azure DevOps&lt;br&gt;&lt;b&gt;ADR&lt;/b&gt; — Architecture Decision Record&lt;br&gt;&lt;b&gt;CC&lt;/b&gt; — Claude Code (CLI)&lt;br&gt;&lt;b&gt;Ctx&lt;/b&gt; — Context: which Fabric workspace / Git branch is active&lt;br&gt;&lt;b&gt;MCP&lt;/b&gt; — Model Context Protocol&lt;br&gt;&lt;b&gt;PR&lt;/b&gt; — Pull Request&lt;br&gt;&lt;b&gt;SC&lt;/b&gt; — Source Control (Fabric panel)&lt;br&gt;&lt;b&gt;TMDL&lt;/b&gt; — Tabular Model Definition Language&lt;br&gt;&lt;b&gt;VSC&lt;/b&gt; — Visual Studio Code&lt;br&gt;&lt;b&gt;WS&lt;/b&gt; — Workspace" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="abbrevBox">
          <mxGeometry x="10" y="32" width="280" height="225" as="geometry" />
        </mxCell>

        <!-- ===== NOTES & CONVENTIONS (footnoted a–m) ===== -->
        <mxCell id="notesBox" value="Notes &amp; Conventions (cited in steps as ᵃ ᵇ ᶜ …)" style="swimlane;html=1;startSize=28;fontStyle=1;fillColor=#fff9e6;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="601" width="300" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="notesText" value="&lt;b&gt;a — Spec templates:&lt;/b&gt; reusable Markdown skeletons (ADR, source-to-target mapping, measure definitions, pipeline specs) generated via CC CLI to standardise design documentation.&lt;br&gt;&lt;br&gt;&lt;b&gt;b — Branch strategy:&lt;/b&gt; main + short-lived feature branches only. Test/Prod content is delivered by Deployment Pipelines, not Git — no test/prod branches exist; Git binding applies only to Dev-stage workspaces.&lt;br&gt;&lt;br&gt;&lt;b&gt;c — Shared Integration/Dev WS:&lt;/b&gt; bound to main and doubles as the Deployment Pipeline Dev stage. Personal Dev WSs sit outside the deployment pipeline.&lt;br&gt;&lt;br&gt;&lt;b&gt;d — Isolated Personal Dev WS:&lt;/b&gt; per developer; the feature branch is created and pushed locally FIRST — only then can Fabric &quot;Branch out to new workspace&quot; reference and bind to it (the safe inner loop).&lt;br&gt;&lt;br&gt;&lt;b&gt;e — No auto-commit:&lt;/b&gt; Fabric Git Integration never commits automatically; a manual Source Control → Commit is always required.&lt;br&gt;&lt;br&gt;&lt;b&gt;f — Sync rule:&lt;/b&gt; local edits are invisible to Fabric until pushed to ADO and pulled via workspace &quot;Update&quot;. MCP always operates on workspace state, never local files.&lt;br&gt;&lt;br&gt;&lt;b&gt;g — Validation loop:&lt;/b&gt; MCP-driven smoke tests in the Personal WS — pipeline runs on sample data, Livy row-count checks, validation DAX vs expected results, semantic model refresh without errors — before any PR.&lt;br&gt;&lt;br&gt;&lt;b&gt;h — Commit/PR message body:&lt;/b&gt; [domain]_[artifact]_[action]; PRs merge feature → main with peer review.&lt;br&gt;&lt;br&gt;&lt;b&gt;i — Automation candidate:&lt;/b&gt; the manual WS &quot;Update&quot; is a single-owner action today; automatable via the Fabric Git REST API.&lt;br&gt;&lt;br&gt;&lt;b&gt;j — Deployment Rules:&lt;/b&gt; Deployment Pipelines copy artifact structure/metadata only — data does not deploy, and data source bindings are NOT retargeted automatically. Configure rules per stage to rebind the Direct Lake model/connections to Test/Prod sources.&lt;br&gt;&lt;br&gt;&lt;b&gt;k — Report hand-off:&lt;/b&gt; only the published/certified semantic model — after Prod deployment — is the formal interface to the separate Report Development workflow (stable schema; no &quot;shifting sand&quot;). Report commits land in the same repo.&lt;br&gt;&lt;br&gt;&lt;b&gt;l — Release tag:&lt;/b&gt; at Test-Passed, tag the deployed commit on main (e.g. release/v1.2) via git tag -a + push --tags, or an ADO pipeline task. Because Prod WS is not Git-bound, the tag is the authoritative record of exactly what is deployed to Prod (audit / rollback).&lt;br&gt;&lt;br&gt;&lt;b&gt;m — Commit prefixes by surface:&lt;/b&gt; local VSC: &quot;VSC Commit: &amp;lt;msg&amp;gt;&quot; · local CC: &quot;CC Commit: &amp;lt;msg&amp;gt;&quot; · ADO web: &quot;ADO Commit: &amp;lt;msg&amp;gt;&quot; · Fabric UI: &quot;Fab Commit: &amp;lt;msg&amp;gt;&quot;. Message body follows note h." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="notesBox">
          <mxGeometry x="10" y="32" width="280" height="1075" as="geometry" />
        </mxCell>

        <!-- ===== PHASE LABELS ===== -->
        <mxCell id="ph1" value="PHASE I&#10;Plan &amp; Setup" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ph2" value="PHASE II&#10;Scaffold &amp; Synchronize" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="625" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ph3" value="PHASE III&#10;Development (DEV)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="985" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ph4" value="PHASE IV&#10;Integration &amp; QA" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="1775" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ph5" value="PHASE V&#10;Release &amp; Monitor" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="2250" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Bold black phase separators -->
        <mxCell id="sepA" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="615" as="sourcePoint" /><mxPoint x="780" y="615" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sepB" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="975" as="sourcePoint" /><mxPoint x="780" y="975" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sepC" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1765" as="sourcePoint" /><mxPoint x="780" y="1765" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="sepD" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="2240" as="sourcePoint" /><mxPoint x="780" y="2240" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===== START ===== -->
        <mxCell id="start" value="START" style="ellipse;html=1;fillColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="70" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- ===== PHASE I ===== -->
        <mxCell id="n1" value="&lt;b&gt;1. Scope &amp;amp; Architect Solution &lt;sup&gt;a&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CC CLI spec templates + ADR docs as Markdown&lt;br&gt;&lt;i&gt;Ctx: local files · no branch yet&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. Create ADO Repo &amp;amp; Clone Locally &lt;sup&gt;b&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Branch strategy: main + short-lived feature branches (no test/prod branches)&lt;br&gt;&lt;i&gt;Ctx: Git · main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="255" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. Link Fabric Workspaces to Repo &lt;sup&gt;c d&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bind Shared Integration/Dev WS ↔ main via native Git integration; Personal Dev WSs created later via branch-out (Step 8)&lt;br&gt;&lt;i&gt;Ctx: Fabric UI · WS: Shared Integration · Branch: main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="370" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;4. Configure MCP Servers in CC CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ms-fabric-mcp-server, powerbi-modeling-mcp; opt-in per session&lt;br&gt;&lt;i&gt;Ctx: local CLI · no WS context&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- ===== PHASE II ===== -->
        <mxCell id="n5" value="&lt;b&gt;5. Scaffold Empty Fabric Artifact Shells&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MCP: create_lakehouse / create_pipeline / create_notebook / create_dataflow / create_semantic_model&lt;br&gt;&lt;i&gt;Ctx: WS: Shared Integration · Branch: main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="640" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;6. Manual Fabric Source Control Commit &lt;sup&gt;e m&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scaffolded items appear as uncommitted changes — manually Commit (&quot;Fab Commit: …&quot;; no auto-commit exists)&lt;br&gt;&lt;i&gt;Ctx: WS: Shared Integration · Branch: main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="760" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;7. Git Pull Locally&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pull folder structures / TMDL / metadata into VSC&lt;br&gt;&lt;i&gt;Ctx: local Git · main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="880" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- ===== PHASE III ===== -->
        <mxCell id="n8" value="&lt;b&gt;8. Create Feature Branch LOCALLY → Push → Branch-Out Personal Dev WS &lt;sup&gt;d&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(1) git checkout -b feature/x — local only · (2) git push -u origin feature/x — now visible in ADO · (3) Fabric &quot;Branch out to new workspace&quot; can now reference &amp;amp; bind to it&lt;br&gt;&lt;i&gt;Ctx: WS: Personal Dev · Branch: feature/*&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="1000" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;9. Author TMDL, T-SQL &amp;amp; Pipeline JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;VSC co-authoring + CC CLI local generators (stored procs, DAX measures, pipeline JSON)&lt;br&gt;&lt;i&gt;Ctx: local files · Branch: feature/*&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="1140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;10. Git Commit &amp;amp; Push to ADO &lt;sup&gt;f m&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Push local edits (&quot;VSC Commit: …&quot; / &quot;CC Commit: …&quot;) — Fabric cannot see local files&lt;br&gt;&lt;i&gt;Ctx: Git · Branch: feature/*&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="1260" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;11. Fabric SC &quot;Update&quot; (Pull) into Personal WS &lt;sup&gt;f&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sync WS so MCP operations run against current artifacts&lt;br&gt;&lt;i&gt;Ctx: WS: Personal Dev · Branch: feature/*&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="1370" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;12. Execute MCP-Only Operations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Run pipelines, Livy/Spark statements, refresh_semantic_model, validation DAX queries, poll job status&lt;br&gt;&lt;i&gt;Ctx: WS: Personal Dev&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="1480" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;13. Local / Private Validation Loop &lt;sup&gt;g&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Functional checks &amp;amp; smoke tests in isolated WS&lt;br&gt;&lt;i&gt;Ctx: WS: Personal Dev&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="1600" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="More Dev&#10;Needed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="1680" width="160" height="75" as="geometry" />
        </mxCell>

        <!-- ===== PHASE IV ===== -->
        <mxCell id="n14" value="&lt;b&gt;14. PR: Feature Branch → main &lt;sup&gt;h m&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Peer review &amp;amp; merge validated work (&quot;ADO Commit: …&quot;)&lt;br&gt;&lt;i&gt;Ctx: ADO · feature/* → main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="1790" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;15. Update Shared Integration/Dev WS &lt;sup&gt;c i&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fabric Web UI → Source Control → &quot;Update&quot; (pull) merged commit&lt;br&gt;&lt;i&gt;Ctx: WS: Shared Integration · Branch: main&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="1900" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;16. Validate Merged Changes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Integration queries, end-to-end pipeline runs, Livy row counts&lt;br&gt;&lt;i&gt;Ctx: WS: Shared Integration&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="2015" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Model / Data&#10;Validation&#10;Passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="2115" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- ===== PHASE V ===== -->
        <mxCell id="n17" value="&lt;b&gt;17. Promote Dev → Test (Deployment Pipelines) &lt;sup&gt;j&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fabric UI Deploy: assign Dev/Test/Prod WSs to stages; configure Deployment Rules to rebind data sources; validate in Test WS&lt;br&gt;&lt;i&gt;Ctx: pipeline stages · no Git binding beyond Dev&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="2280" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Test&#10;Passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="2410" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Code Defect&#10;or Deployment&#10;Config?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="2405" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;18. Apply Release Tag to main &lt;sup&gt;l&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tag most recent commit (e.g. release/v1.2) — the exact code state being deployed to Prod&lt;br&gt;&lt;i&gt;Ctx: Git/ADO · Branch: main (tag)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="2530" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;19. Promote Test → Prod (Deployment Pipelines) &lt;sup&gt;j&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fabric UI Deploy stage promote; change-managed release window&lt;br&gt;&lt;i&gt;Ctx: pipeline stages&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="2640" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;20. Semantic Model Published / Certified &lt;sup&gt;k&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Post-Prod endorsement — stable schema; formal hand-off to separate Report Development workflow&lt;br&gt;&lt;i&gt;Ctx: WS: Prod&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="2750" width="300" height="80" as="geometry" />
        </mxCell>
