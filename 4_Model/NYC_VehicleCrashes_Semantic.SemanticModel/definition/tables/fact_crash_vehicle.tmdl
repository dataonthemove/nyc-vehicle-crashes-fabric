table fact_crash_vehicle
	lineageTag: b8540bca-cde8-408b-ac4f-0a67761442f5
	sourceLineageTag: [dbo].[fact_crash_vehicle]

	/// Vehicles involved in the filtered crashes — one row per vehicle per collision.
	measure 'Total Vehicles Involved' = COUNTROWS ( fact_crash_vehicle )
		formatString: #,0

	/// Reported occupants across involved vehicles. Trustworthy only because of the outlier cap applied in 44ea207 — raw source values inflated this ~888x.
	measure 'Total Occupants' = SUM ( fact_crash_vehicle[vehicle_occupants] )
		formatString: #,0

	/// Vehicles with a reported occupant count above zero. Denominator for Average Occupants per Vehicle.
	measure 'Vehicles with Occupant Data' = CALCULATE ( [Total Vehicles Involved], KEEPFILTERS ( fact_crash_vehicle[vehicle_occupants] > 0 ) )
		formatString: #,0

	/// Share of involved vehicles that report a usable occupant count. Roughly half the source rows report 0 or blank, so read every occupancy measure against this.
	measure 'Occupant Data Coverage %' = DIVIDE ( [Vehicles with Occupant Data], [Total Vehicles Involved] )
		formatString: 0.0%

	/// Mean occupants per vehicle, counting only vehicles that report an occupant count above zero. Dividing by all vehicles instead returns ~0.7, because ~51% of source rows report 0 or blank occupants and averaging those in understates the true figure. Depends on the same occupant cap as Total Occupants.
	measure 'Average Occupants per Vehicle' = DIVIDE ( [Total Occupants], [Vehicles with Occupant Data] )
		formatString: #,0.00

	/// Mean vehicles involved per collision in the current filter context.
	measure 'Vehicles per Crash' = DIVIDE ( [Total Vehicles Involved], DISTINCTCOUNT ( fact_crash_vehicle[collision_key] ) )
		formatString: #,0.00

	column fact_crash_vehicle_id
		dataType: int64
		formatString: 0
		lineageTag: a9e8cce1-8754-4cc1-9fed-c7e4b78e8720
		sourceLineageTag: fact_crash_vehicle_id
		summarizeBy: none
		sourceColumn: fact_crash_vehicle_id

		annotation SummarizationSetBy = Automatic

	column collision_key
