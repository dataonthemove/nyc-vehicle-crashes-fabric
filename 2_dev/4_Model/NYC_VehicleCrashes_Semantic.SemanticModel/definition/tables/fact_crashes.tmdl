table fact_crashes
	lineageTag: 4081c01e-bd87-4895-8a18-92d9cc1f76a0
	sourceLineageTag: [dbo].[fact_crashes]

	/// Count of distinct collision events. The grain of fact_crashes is one row per collision.
	measure 'Total Crashes' = COUNTROWS ( fact_crashes )
		formatString: #,0
		lineageTag: ddd6da82-3e4f-490c-b0c5-3b65211ca904

	/// Persons injured in the filtered crashes, all road-user types combined.
	measure 'Persons Injured' = SUM ( fact_crashes[persons_injured] )
		formatString: #,0
		lineageTag: a145661d-6b82-4395-ac6e-4b3ded731408

	/// Persons killed in the filtered crashes, all road-user types combined.
	measure 'Persons Killed' = SUM ( fact_crashes[persons_killed] )
		formatString: #,0
		lineageTag: b2e08112-3516-4d92-8231-0619b5dd86ad

	/// Pedestrians injured in the filtered crashes.
	measure 'Pedestrians Injured' = SUM ( fact_crashes[pedestrians_injured] )
		formatString: #,0
		lineageTag: f60a759e-5d11-4ef0-aad6-1aef4feeb24e

	/// Pedestrians killed in the filtered crashes.
	measure 'Pedestrians Killed' = SUM ( fact_crashes[pedestrians_killed] )
		formatString: #,0
		lineageTag: c66c4c01-2f36-42d2-b676-ba94102bdec8

	/// Cyclists injured in the filtered crashes.
	measure 'Cyclists Injured' = SUM ( fact_crashes[cyclists_injured] )
		formatString: #,0
		lineageTag: 27ff5b72-746d-408d-abae-040ef529bb80

	/// Cyclists killed in the filtered crashes.
	measure 'Cyclists Killed' = SUM ( fact_crashes[cyclists_killed] )
		formatString: #,0
		lineageTag: a83ca342-6410-4569-aa90-cb21ee0f74d3

	/// Motorists injured in the filtered crashes.
	measure 'Motorists Injured' = SUM ( fact_crashes[motorists_injured] )
		formatString: #,0
		lineageTag: e65b238b-d7c7-4ad2-bb77-e89800f0b394

	/// Motorists killed in the filtered crashes.
	measure 'Motorists Killed' = SUM ( fact_crashes[motorists_killed] )
		formatString: #,0
		lineageTag: 88ebedef-943c-48be-b444-0a17bcfdc852

	/// Crashes with at least one person injured.
	measure 'Crashes with Injury' = CALCULATE ( [Total Crashes], KEEPFILTERS ( fact_crashes[persons_injured] > 0 ) )
		formatString: #,0
		lineageTag: 5d49119a-1ee1-4109-9005-9ef9da15b1b0

	/// Crashes with at least one person killed.
	measure 'Crashes with Fatality' = CALCULATE ( [Total Crashes], KEEPFILTERS ( fact_crashes[persons_killed] > 0 ) )
		formatString: #,0
		lineageTag: eacc3c83-93b0-407b-81a1-ac9c9049d522

	/// Share of crashes that injured at least one person. Crash-level rate, not persons per crash.
	measure 'Injury Rate' = DIVIDE ( [Crashes with Injury], [Total Crashes] )
		formatString: 0.0%
		lineageTag: 6b01b19e-d31d-400d-9373-7b88d1596e57

	/// Share of crashes that killed at least one person.
	measure 'Fatality Rate' = DIVIDE ( [Crashes with Fatality], [Total Crashes] )
		formatString: 0.00%
		lineageTag: d0f4b146-4220-46b8-9f00-ec34bfdff572

	/// Average persons injured per crash in the current filter context.
	measure 'Injuries per Crash' = DIVIDE ( [Persons Injured], [Total Crashes] )
		formatString: #,0.00
		lineageTag: 2540d135-7bf5-4694-bf4e-48f8c81b099c

	/// Total Crashes for the equivalent period one year earlier. Requires dim_date marked as a date table.
	measure 'Crashes PY' = CALCULATE ( [Total Crashes], SAMEPERIODLASTYEAR ( dim_date[full_date] ) )
		formatString: #,0
		lineageTag: 2aef1862-ca13-4419-bb73-0189fadabc62

	/// Year-over-year change in crash volume. Blank when there is no prior-year comparison period.
	measure 'Crashes YoY %' = DIVIDE ( [Total Crashes] - [Crashes PY], [Crashes PY] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 537ffbb9-9296-4b9f-bfc1-719e5311f842

	/// Total Crashes for the prior month. Requires dim_date marked as a date table.
	measure 'Crashes PM' = CALCULATE ( [Total Crashes], DATEADD ( dim_date[full_date], -1, MONTH ) )
		formatString: #,0
		lineageTag: 8573a063-a350-4304-a15f-2cf4e6c10dc7

	/// Month-over-month change in crash volume. Blank when there is no prior-month comparison period.
	measure 'Crashes MoM %' = DIVIDE ( [Total Crashes] - [Crashes PM], [Crashes PM] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: ccf83906-3d6e-498a-adf9-8284e6472a5c

