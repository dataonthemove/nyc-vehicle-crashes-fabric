model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DatabaseQuery"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","MCP-PBIModeling","DaxQueryView_Desktop","TMDL-Extension"]

ref table 'Dim Vehicle Circumstance'
ref table 'Dim Person'
ref table 'Dim Location'
ref table 'Dim Contributing Factor'
ref table 'Dim Vehicle'
ref table 'Dim Date'
ref table bridge_crash_factor
ref table 'Fact Crashes'
ref table 'Fact Crash Vehicles'
ref table dim_factor_group
ref table 'Fact Crash Persons'
ref table 'Dim Driver'

