<mxfile host="Electron" agent="Claude">
  <diagram id="fabric-sdlc-flow-v14" name="Fabric SDLC Process Flow v14">
    <mxGraphModel dx="1951" dy="942" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="4120" background="#E6E6E6" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=3;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2040" height="4060" as="geometry"/></mxCell>
        <mxCell id="title" value="Microsoft Fabric SDLC Process Flow (v15) — Source-to-Semantic-Model Workflow" style="text;html=1;fontSize=36;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="45" width="800" height="46" as="geometry"/></mxCell>
        <mxCell id="phb1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="345" width="500" height="535" as="geometry"/></mxCell>
        <mxCell id="phb2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="960" width="500" height="535" as="geometry"/></mxCell>
        <mxCell id="phb3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="225" width="870" height="1625" as="geometry"/></mxCell>
        <mxCell id="phb4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="1930" width="870" height="590" as="geometry"/></mxCell>
        <mxCell id="phb5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="2600" width="870" height="1310" as="geometry"/></mxCell>
        <mxCell id="pht1" value="PHASE I — Plan &amp;amp; Setup" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="pht2" value="PHASE II — Scaffold &amp;amp; Synchronize" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="915" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="pht3" value="PHASE III — Development (DEV)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="180" width="870" height="34" as="geometry"/></mxCell>
        <mxCell id="pht4" value="PHASE IV — Integration &amp;amp; QA" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="1885" width="870" height="34" as="geometry"/></mxCell>
        <mxCell id="pht5" value="PHASE V — Release &amp;amp; Monitor" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="2555" width="870" height="34" as="geometry"/></mxCell>
        <mxCell id="start" value="START" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=14;fontStyle=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;1. Scope &amp;amp; Architect Solution ᵃ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Baseline architecture and initial specs — ADRs, source-to-target mappings, measure definitions — drafted from CC CLI templates.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files · no branch yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="170" y="370" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. Create ADO Repo &amp;amp; Clone Locally ᵇ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Create the repo in ADO, then clone it to the local workstation.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO + local Git · main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="490" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. Provision WSs, Assign Capacity &amp;amp; Create Deployment Pipeline ᶜ ⁱ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Assign every WS to a Fabric capacity; bind the Shared Integration/Dev WS ↔ main; create the Test &amp;amp; Prod WSs and assign all three to deployment-pipeline stages.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Shared Integration · main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="170" y="615" width="460" height="125" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;4. Configure MCP Servers in CC CLI ʳ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ms-fabric-mcp-server, powerbi-modeling-mcp registered in local config; opt-in per session.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local CLI · no WS context&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="170" y="765" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;5. Scaffold Empty Fabric Artifact Shells &amp;amp; Variable Library ʳ ᵘ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;MCP: create_lakehouse / create_pipeline / create_notebook / create_dataflow / create_semantic_model, plus the Variable Library item.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration · Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="985" width="460" height="115" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;6. Establish Source Connectivity ᵗ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Create source connections / gateways, land raw source data, and create OneLake shortcuts into the scaffolded lakehouse — the source end of source-to-semantic-model.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Shared Integration&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="170" y="1125" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;7. Manual Fabric Source Control Commit ᵉ ˡ ʳ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Scaffolded items appear as uncommitted changes — commit them from the Fabric Source Control panel.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration · Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="170" y="1250" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;8. Git Pull Locally&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pull folder structures / TMDL / metadata into VSC.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local Git · main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="1375" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;9. Refine Requirements &amp;amp; Specs ᵃ ˢ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Re-entry point for every iteration — update the ADRs, mappings and measure definitions before any authoring begins.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files · Branch: main → feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="250" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;10. Branch Out to Personal Dev WS ᵈ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric SC → Branches → “Branch out to new workspace”: creates feature/x and the Personal Dev WS bound to it.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Personal Dev · Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="370" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;11. Fetch &amp;amp; Checkout Feature Branch Locally ᵈ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;git fetch origin · git checkout feature/x.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local Git · Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="495" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;12. CC Plan Mode — Propose Implementation Plan ˢ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CC CLI plan mode drafts the change plan against the Step 9 specs.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local CLI · Branch: feature/* · read-only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="605" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="dP" value="Plan Approved?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="715" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;13. Author TMDL, T-SQL &amp;amp; Pipeline JSON (incl. RLS / OLS Roles) ʳ ᵛ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;VSC co-authoring + CC CLI local generators: stored procs, DAX measures, row- and object-level security roles, pipeline JSON. Commit the approved plan alongside the code.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files · Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="855" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;14. Git Commit &amp;amp; Push to ADO ᶠ ˡ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Push local edits to the feature branch in ADO.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Git · Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="980" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;15. Fabric SC “Update” (Pull) into Personal WS ᶠ ʰ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sync the Personal Dev WS to the pushed commit.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Personal Dev · Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="1080" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;16. Execute MCP-Only Operations ʳ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Run pipelines, Livy/Spark statements, refresh_semantic_model and validation DAX queries; poll job status.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Personal Dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="1180" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;17. Private Validation Loop (Personal WS) ʳ ᵛ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Functional checks, smoke tests and “View as role” RLS/OLS checks in the isolated Personal Dev WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Personal Dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="1295" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="d1b" value="Private Validation Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="1410" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="d1" value="More Dev Needed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="1550" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="dS" value="Feature Branch In Sync With main?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="1690" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;18. Sync main → Feature Branch ⁿ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;git fetch + merge/rebase main; resolve conflicts locally in VSC; re-push.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local Git → ADO · feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="1695" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;19. PR: Feature Branch → main ᵍ ˡ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Merge validated work, including the spec and plan Markdown.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO · feature/* → main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1250" y="1955" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;20. Update Shared Integration/Dev WS ᶜ ʰ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric Web UI → Source Control → “Update” the merged commit.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration · Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="2060" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;21. Validate Merged Changes ʳ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Integration queries, end-to-end pipeline runs, Livy row counts.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="2165" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="d2" value="Model / Data Validation Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="2265" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;22. Revert Merge on main ᵐ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ADO → Revert the merged PR, restoring main to the last known-good commit.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO · Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="2273" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;23. Clean Up Feature Branch &amp;amp; Personal Dev WS ᵒ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Delete the merged feature branch in ADO; delete or unbind the Personal Dev WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO + Fabric UI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="2405" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;24. Promote Dev → Test (Deployment Pipelines) ⁱ ᵘ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric UI Deploy to the Test stage.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: pipeline stages · no Git binding beyond Dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="2625" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;25. Bind Data Sources &amp;amp; Set Credentials (Test) ⁱ ʸ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;On the target item's settings page, repoint the deployed items at the Test WS sources and supply credentials. First release, or when a source changes.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Test&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="2730" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="d3" value="Test Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="2850" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="d4" value="Code Defect or Deployment Config?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="2845" width="240" height="125" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;26. Apply Release Tag to main ᵏ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Azure Repos → Tags → New tag on the exact commit deployed to Test (e.g. release/v1.2).&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO · Branch: main (tag)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1250" y="2990" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;27. Promote Test → Prod (Deployment Pipelines) ⁱ ᵘ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric UI Deploy stage promote, within a change-managed release window.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: pipeline stages&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3100" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;28. Bind Data Sources &amp;amp; Set Credentials (Prod) ⁱ ʸ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Repoint the promoted items at the Prod WS sources and supply credentials. First release, or when a source changes — not carried over, but not reset either.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Prod&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3205" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;29. Assign Prod WS RBAC &amp;amp; RLS Role Membership ᵛ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Grant workspace roles and semantic model RLS role membership in the Prod WS, now that the model exists there.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Prod&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3325" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;30. Post-Deployment Verification (Prod) ʳ ˣ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Smoke-test the promoted release: model refresh, validation DAX vs expected results, connection and role checks.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Prod · read/validate only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="3440" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="d5" value="Prod Verification Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="3555" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;31. Roll Back Prod Release ᵏ ˣ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ADO → Revert the PR(s) merged since the previous release tag, restoring main by new commits.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO · Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="3560" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;32. Endorse Semantic Model in Prod (Manual) ʲ ᵖ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Apply Promoted / Certified on the Prod semantic model.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI · WS: Prod&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3695" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;b&gt;33. Monitor, Triage &amp;amp; Iterate ʳ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CC CLI diagnostics, pipeline activity polling, Spark/Livy logs.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Prod (read/diagnostics only)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="3800" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="end" value="END OF RELEASE CYCLE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=14;fontStyle=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1380" y="3940" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="offpage" value="&lt;b&gt;Report Development Workflow ʲ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Separate downstream process — out of scope for this flow.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1760" y="3775" width="280" height="90" as="geometry"/></mxCell>
