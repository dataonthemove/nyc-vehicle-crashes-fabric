        <mxCell id="n19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#b0e3e6;strokeColor=#0e8088;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;19. Sync main → Feature Branch ᵐ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Merge (or rebase onto) main; resolve conflicts locally in VSC; re-push.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: local Git · Branch: feature/*&lt;/i&gt;" vertex="1">
          <mxGeometry height="115" width="240" x="880" y="1820" as="geometry" />
        </mxCell>
        <mxCell id="n20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;20. PR: Feature Branch → main ᵍ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Merge validated work, including the spec and plan Markdown.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: ADO · feature/* → main&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="460" x="1250" y="2080" as="geometry" />
        </mxCell>
        <mxCell id="n21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;21. Update Shared Integration/Dev WS ᶜ ʰ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Fabric Web UI → Source Control → “Update” the merged commit.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: Fabric UI · WS: Shared Integration · Branch: main&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="460" x="1250" y="2185" as="geometry" />
        </mxCell>
        <mxCell id="n22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;22. Validate Merged Changes ᵖ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Integration queries, end-to-end pipeline runs, Livy row counts.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: CC/MCP · WS: Shared Integration · Branch: main&lt;/i&gt;" vertex="1">
          <mxGeometry height="75" width="460" x="1250" y="2290" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Model / Data Validation Passed?" vertex="1">
          <mxGeometry height="115" width="280" x="1340" y="2390" as="geometry" />
        </mxCell>
        <mxCell id="n23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;23. Revert Merge on main ˡ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;ADO → Revert the merged PR, restoring main to the last known-good commit.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: ADO · Branch: main&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="240" x="880" y="2398" as="geometry" />
        </mxCell>
        <mxCell id="n24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;24. Clean Up Feature Branch &amp;amp; Personal Dev WS ⁿ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Delete the merged feature branch in ADO; delete or unbind the Personal Dev WS.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: ADO + Fabric UI&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="460" x="1250" y="2530" as="geometry" />
        </mxCell>
        <mxCell id="n25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;25. Promote Dev → Test (Deployment Pipelines) ᵇ ⁱ ᵗ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Fabric UI Deploy to the Test stage.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: Fabric UI · WS: Dev → Test&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="460" x="1250" y="2750" as="geometry" />
        </mxCell>
        <mxCell id="n26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;26. Bind Data Sources &amp;amp; Set Credentials (Test) ⁱ ˣ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;On the target item&#39;s settings page, repoint the deployed items at the Test WS sources and supply credentials. First release, or when a source changes.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: Fabric UI · WS: Test&lt;/i&gt;" vertex="1">
          <mxGeometry height="95" width="460" x="1250" y="2855" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Test Passed?" vertex="1">
          <mxGeometry height="115" width="280" x="1340" y="2975" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Code Defect or Deployment Config?" vertex="1">
          <mxGeometry height="125" width="240" x="880" y="2970" as="geometry" />
        </mxCell>
        <mxCell id="n27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;27. Apply Release Tag to main ᵏ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Azure Repos → Tags → New tag on the exact commit deployed to Test (e.g. release/v1.2).&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: ADO · Branch: main (tag)&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="460" x="1250" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;28. Promote Test → Prod (Deployment Pipelines) ᵇ ⁱ ᵗ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Fabric UI Deploy stage promote, within a change-managed release window.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: Fabric UI · WS: Test → Prod&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="460" x="1250" y="3225" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;29. Bind Data Sources &amp;amp; Set Credentials (Prod) ⁱ ˣ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Repoint the promoted items at the Prod WS sources and supply credentials. First release, or when a source changes — not carried over, but not reset either.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: Fabric UI · WS: Prod&lt;/i&gt;" vertex="1">
          <mxGeometry height="95" width="460" x="1250" y="3330" as="geometry" />
        </mxCell>
        <mxCell id="n30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;30. Assign Prod WS RBAC &amp;amp; RLS Role Membership ᵘ ᵛ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Grant workspace roles and semantic model RLS role membership in the Prod WS, now that the model exists there.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: Fabric UI · WS: Prod&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="1250" y="3450" as="geometry" />
        </mxCell>
        <mxCell id="n31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;31. Post-Deployment Verification (Prod) ᵖ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Smoke-test the promoted release: model refresh, validation DAX vs expected results, connection and role checks.&lt;/font&gt;&lt;br&gt;&lt;i style=&#39;font-size:9px&#39;&gt;Ctx: CC/MCP · WS: Prod&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="1250" y="3565" as="geometry" />
        </mxCell>
