<mxfile host="Electron" agent="Claude">
  <diagram id="fabric-sdlc-flow-v10" name="Fabric SDLC Process Flow v10">
    <mxGraphModel dx="1951" dy="942" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="4160" background="#E6E6E6" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=3;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2040" height="4110" as="geometry"/></mxCell>
        <mxCell id="title" value="Microsoft Fabric SDLC Process Flow (v10) &amp;#8212; Source-to-Semantic-Model Workflow" style="text;html=1;fontSize=36;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="45" width="800" height="46" as="geometry"/></mxCell>
        <mxCell id="phb1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="345" width="500" height="660" as="geometry"/></mxCell>
        <mxCell id="phb2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="1085" width="500" height="400" as="geometry"/></mxCell>
        <mxCell id="phb3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1230" y="225" width="500" height="1780" as="geometry"/></mxCell>
        <mxCell id="phb4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="2085" width="870" height="650" as="geometry"/></mxCell>
        <mxCell id="phb5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d4d4d;strokeWidth=4;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="2815" width="870" height="1175" as="geometry"/></mxCell>
        <mxCell id="pht1" value="PHASE I &amp;#8212; Plan &amp;amp; Setup" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="pht2" value="PHASE II &amp;#8212; Scaffold &amp;amp; Synchronize" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="1040" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="pht3" value="PHASE III &amp;#8212; Development (DEV)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1230" y="180" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="pht4" value="PHASE IV &amp;#8212; Integration &amp;amp; QA" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="2040" width="870" height="34" as="geometry"/></mxCell>
        <mxCell id="pht5" value="PHASE V &amp;#8212; Release &amp;amp; Monitor" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="2770" width="870" height="34" as="geometry"/></mxCell>
        <mxCell id="start" value="START" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=14;fontStyle=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;1. Scope &amp;amp; Architect Solution ᵃ ᵗ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CC CLI spec templates + ADR docs as Markdown; baseline architecture. Recurring requirement refinement happens later at Step 9.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files &amp;#183; no branch yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="170" y="370" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. Create ADO Repo &amp;amp; Clone Locally ᵇ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Create the repo in ADO, then clone to the local workstation. Branch strategy: main + short-lived feature branches (no test/prod branches).&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO + local Git &amp;#183; main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="490" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. Provision WSs, Assign Capacity &amp;amp; Create Deployment Pipeline ᶜ ʲ ʸ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Assign every WS to a Fabric capacity; bind Shared Integration/Dev WS &amp;#8596; main via native Git integration; create Test &amp;amp; Prod WSs and assign Dev/Test/Prod to deployment-pipeline stages (one-off setup).&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI &amp;#183; WS: Shared Integration &amp;#183; main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="170" y="615" width="460" height="125" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;4. Establish Source Connectivity ᵛ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Create source connections / gateways, land raw source data, and create OneLake shortcuts &amp;#8212; the source end of source-to-semantic-model.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI &amp;#183; WS: Shared Integration&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="170" y="765" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;5. Configure MCP Servers in CC CLI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ms-fabric-mcp-server, powerbi-modeling-mcp registered in local config; opt-in per session.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local CLI &amp;#183; no WS context&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="170" y="890" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;6. Scaffold Empty Fabric Artifact Shells &amp;amp; Variable Library ˢ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;MCP: create_lakehouse / create_pipeline / create_notebook / create_dataflow / create_semantic_model, plus a Variable Library with one value set per stage. One-off exception to the &amp;#8220;no MCP creation&amp;#8221; rule.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration &amp;#183; Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="1110" width="460" height="115" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;7. Manual Fabric Source Control Commit ᵉ ᵐ ˢ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Scaffolded items appear as uncommitted changes &amp;#8212; manually Commit (&amp;#8220;Fab Commit: &amp;#8230;&amp;#8221;; no auto-commit exists).&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration &amp;#183; Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="170" y="1250" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;8. Git Pull Locally&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pull folder structures / TMDL / metadata into VSC.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local Git &amp;#183; main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="1375" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;9. Refine Requirements &amp;amp; Specs ᵗ ᵘ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Re-entry point for every iteration. Update ADRs, source-to-target mappings and measure definitions as versioned Markdown in the repo; merged via the same PR as the code.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files &amp;#183; Branch: main &amp;#8594; feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="250" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;10. Branch Out to Personal Dev WS ᵈ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric SC &amp;#8594; Branches &amp;#8594; &amp;#8220;Branch out to new workspace&amp;#8221;: Fabric creates feature/x AND the Personal Dev WS bound to it; repoint copied item bindings and repopulate data.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI &amp;#183; WS: Personal Dev &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="375" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;11. Fetch &amp;amp; Checkout Feature Branch Locally ᵈ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;git fetch origin &amp;#183; git checkout feature/x &amp;#8212; local clone now tracks the Fabric-created branch.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local Git &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="510" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;12. CC Plan Mode &amp;#8212; Propose Implementation Plan ᵘ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CC CLI plan mode drafts the change plan against the specs from Step 9. No files are written to disk at this stage.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local CLI &amp;#183; Branch: feature/* &amp;#183; read-only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="620" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="dP" value="Plan Approved?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="740" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;13. Author TMDL, T-SQL &amp;amp; Pipeline JSON ˢ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;VSC co-authoring + CC CLI local generators (stored procs, DAX measures, pipeline JSON). Commit the approved plan alongside the code.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="885" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;14. Define RLS / OLS Roles in TMDL ˣ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Author row- and object-level security roles as part of the semantic model definition, so they are versioned and PR-reviewed like any other code.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local files &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="1000" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;15. Git Commit &amp;amp; Push to ADO ᶠ ᵐ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Push local edits (&amp;#8220;VSC Commit: &amp;#8230;&amp;#8221; / &amp;#8220;CC Commit: &amp;#8230;&amp;#8221;) &amp;#8212; Fabric cannot see local files.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Git &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="1120" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;16. Fabric SC &amp;#8220;Update&amp;#8221; (Pull) into Personal WS ᶠ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sync WS so MCP operations run against current artifacts.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Personal Dev &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="1235" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;17. Execute MCP-Only Operations ˢ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Run pipelines, Livy/Spark statements, refresh_semantic_model, validation DAX queries, poll job status &amp;#8212; run/read/validate only, no item creation.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Personal Dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="1345" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;18. Private Validation Loop (Personal WS) ᵍ ˣ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Functional checks, smoke tests and &amp;#8220;View as role&amp;#8221; RLS/OLS checks in the isolated Personal Dev WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Personal Dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="1470" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="d1b" value="Private Validation Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="1590" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="d1" value="More Dev Needed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="1735" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;19. Sync main &amp;#8594; Feature Branch &amp;amp; Resolve Conflicts ᵒ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;git fetch + merge/rebase main; resolve TMDL &amp;amp; pipeline JSON conflicts locally in VSC; re-push and re-Update Personal WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: local Git &amp;#8594; ADO &amp;#183; Branch: feature/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="1880" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;20. PR: Feature Branch &amp;#8594; main ʰ ᵐ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Peer review &amp;amp; merge validated work, including the spec and plan Markdown (&amp;#8220;ADO Commit: &amp;#8230;&amp;#8221;).&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO &amp;#183; feature/* &amp;#8594; main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1250" y="2110" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;21. Update Shared Integration/Dev WS ᶜ ⁱ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric Web UI &amp;#8594; Source Control &amp;#8594; &amp;#8220;Update&amp;#8221; (pull) merged commit.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration &amp;#183; Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="2225" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;22. Validate Merged Changes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Integration queries, end-to-end pipeline runs, Livy row counts.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Shared Integration&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="2340" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="d2" value="Model / Data Validation Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="2450" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;23. Revert Merge on main ⁿ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ADO &amp;#8594; Revert the merged PR &amp;#8594; complete revert PR; main returns to last known-good state.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO &amp;#183; Branch: main&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="2455" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;24. Clean Up Feature Branch &amp;amp; Personal Dev WS ᵖ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Delete merged feature branch in ADO; delete or unbind the branched Personal Dev WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO + Fabric UI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="2595" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;25. Promote Dev &amp;#8594; Test (Deployment Pipelines) ʲ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric UI Deploy (stages assigned in Step 3); confirm the Test value set is active in the Variable Library; validate in the Test WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: pipeline stages &amp;#183; no Git binding beyond Dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="2840" width="460" height="105" as="geometry"/></mxCell>
        <mxCell id="d3" value="Test Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="2970" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="d4" value="Code Defect or Deployment Config?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="2965" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;26. Apply Release Tag to main ˡ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Azure Repos &amp;#8594; Tags &amp;#8594; New tag on the exact commit deployed to Test (e.g. release/v1.2) &amp;#8212; not simply the newest commit on main.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO &amp;#183; Branch: main (tag)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1250" y="3115" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;27. Assign Prod WS RBAC &amp;amp; RLS Role Membership ˣ ʸ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Grant workspace roles and semantic model RLS role membership in the Prod WS immediately before promotion &amp;#8212; neither is carried by Deployment Pipelines.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI &amp;#183; WS: Prod&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3235" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;28. Promote Test &amp;#8594; Prod (Deployment Pipelines) ʲ ʷ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fabric UI Deploy stage promote; confirm the Prod value set is active; change-managed release window.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: pipeline stages&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3355" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;29. Post-Deployment Verification (Prod) ᶻ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Smoke-test the promoted release: model refresh, validation DAX vs expected results, connection and role checks against the live Prod WS.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Prod &amp;#183; read/validate only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="3470" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="d5" value="Prod Verification Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="3590" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;30. Roll Back Prod Release ᶻ ˡ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Reset main to the previous release tag, re-Update the Shared WS and re-promote through the pipeline &amp;#8212; a full cycle, not a rollback button.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: ADO + Fabric UI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="3595" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;31. Endorse Semantic Model in Prod (Manual) ᵏ ʳ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Endorsement is NOT carried by Deployment Pipelines &amp;#8212; re-apply Promoted/Certified on the Prod model after every promotion; stable schema for report authoring.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: Fabric UI &amp;#183; WS: Prod&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1250" y="3735" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;32. Monitor, Triage &amp;amp; Iterate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CC CLI diagnostics, pipeline activity polling, Spark/Livy logs.&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9px'&gt;Ctx: WS: Prod (read/diagnostics only)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1250" y="3870" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="end" value="END OF RELEASE CYCLE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=14;fontStyle=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1380" y="4020" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="offpage" value="&lt;b&gt;Report Development Workflow ᵏ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Separate process &amp;#8212; reports authored in the Fabric Web UI against the Prod semantic model; report artifacts stored in the Prod WS. SDLC to be fine-tuned in a later revision.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1760" y="3760" width="280" height="110" as="geometry"/></mxCell>
